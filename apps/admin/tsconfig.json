{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".builds/20260913-214557/types/**/*.ts",
    ".builds/20260913-214557/dev/types/**/*.ts",
    ".builds/20260913-215339/types/**/*.ts",
    ".builds/20260913-215339/dev/types/**/*.ts",
    ".builds/20260913-220709/types/**/*.ts",
    ".builds/20260913-220709/dev/types/**/*.ts",
    ".builds/20260913-221342/types/**/*.ts",
    ".builds/20260913-221342/dev/types/**/*.ts",
    ".builds/20260913-223542/types/**/*.ts",
    ".builds/20260913-223542/dev/types/**/*.ts",
    ".builds/20260913-224705/types/**/*.ts",
    ".builds/20260913-224705/dev/types/**/*.ts",
    ".builds/20260913-224843/types/**/*.ts",
    ".builds/20260913-224843/dev/types/**/*.ts",
    ".builds/20260914-131512/types/**/*.ts",
    ".builds/20260914-131512/dev/types/**/*.ts",
    ".builds/20260914-161752/types/**/*.ts",
    ".builds/20260914-161752/dev/types/**/*.ts",
    ".builds/20260914-163549/types/**/*.ts",
    ".builds/20260914-163549/dev/types/**/*.ts",
    ".builds/20260914-164424/types/**/*.ts",
    ".builds/20260914-164424/dev/types/**/*.ts",
    ".builds/20260914-192557/types/**/*.ts",
    ".builds/20260914-192557/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".builds",
    ".next-verify",
    ".next-test-dev"
  ]
}
